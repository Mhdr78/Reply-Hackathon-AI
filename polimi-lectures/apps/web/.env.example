# "true" = in-browser mock services (default). "false" = HTTP adapters against VITE_API_BASE_URL.
VITE_USE_MOCKS=true
VITE_API_BASE_URL=http://localhost:8000/api

# Video used by all mock lectures. Fallback when public/media/<lectureId>.mp4 is missing. Put an MP4 in public/media/ or point to any URL.
VITE_LECTURE_VIDEO_URL=/media/sample-lecture.mp4

# Simulated network latency (ms) and mock transcription job duration (ms).
VITE_MOCK_LATENCY_MS=450
VITE_MOCK_TRANSCRIPTION_MS=9000

# AI assistant. The dev server proxies /chatbot-api to the chatbot server (services/chatbot) (default http://127.0.0.1:8787).
# Leave VITE_CHATBOT_URL unset to use it, or set it to an empty value to use the in-browser mock assistant.
# VITE_CHATBOT_URL=/chatbot-api
# CHATBOT_SERVER=http://127.0.0.1:8787
