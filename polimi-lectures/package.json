{
  "name": "polimi-lectures",
  "private": true,
  "description": "Polimi lecture recordings with transcripts, AI chapters and an AI assistant (web app + LectureMind chatbot).",
  "scripts": {
    "setup": "npm install --prefix apps/web",
    "dev": "npm run chatbot & npm run web",
    "dev:fake": "VITE_CHATBOT_URL= npm run web",
    "web": "npm run dev --prefix apps/web",
    "chatbot": "../.venv/bin/python ../run.py",
    "chatbot:fake": "cd services/chatbot && ../../../.venv/bin/python -m lecturemind.server --fake-llm",
    "test": "npm run test:web && npm run test:chatbot",
    "test:web": "npm test --prefix apps/web",
    "test:chatbot": "cd services/chatbot && ../../../.venv/bin/python -m unittest discover -s tests -t .",
    "typecheck": "npm run typecheck --prefix apps/web",
    "build": "npm run build --prefix apps/web"
  }
}
