# Paste your OpenRouter API key after the equals sign in your local .env file.
OPENROUTER_API_KEY=

# RAG defaults: local persistent Qdrant; set URL to use a shared server.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=lecture_chunks_v1
RAG_DATA_DIR=.local/rag
RAG_EMBEDDING_MODEL=local/sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_ANSWER_MODEL=openai/gpt-6-luna
RAG_BUDGET_USD=1.0
RAG_REQUEST_LIMIT_USD=0.03
RAG_RERANK=true
RAG_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
